# Vultr Serverless Inference (OpenAI-compatible). Optional: without it the app
# runs fully offline with a deterministic heuristic analyst voice.
# Get a key from the Vultr customer portal > Inference.
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE=https://api.vultrinference.com/v1
# Pick a model from the live list; see README. Example:
VULTR_INFERENCE_MODEL=llama-3.3-70b-instruct-fp8
